{%- comment -%}
  Dark immersive section: frosted glass cards floating in 3D that
  follow the cursor. A lighter take on WebGL "experience" sites.
{%- endcomment -%}
<section class="float-cards" data-float-cards>
  <div class="float-cards__glow" aria-hidden="true"></div>
  <div class="float-cards__head">
    {%- if section.settings.eyebrow != blank -%}<p class="eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
    <h2 class="float-cards__title" data-glitch="{{ section.settings.heading | escape }}">{{ section.settings.heading }}</h2>
  </div>
  <div class="float-cards__stage" data-stage>
    {%- for block in section.blocks -%}
      {%- assign n = forloop.index0 | modulo: 5 -%}
      <a href="{{ block.settings.link | default: '#' }}" class="glass-card glass-card--{{ n }}" data-depth="{{ forloop.index | times: 0.6 | plus: 0.4 }}" {{ block.shopify_attributes }}>
        <div class="glass-card__img">
          {%- if block.settings.image != blank -%}
            {{ block.settings.image | image_url: width: 800 | image_tag: loading: 'lazy', widths: '400, 600, 800', sizes: '(min-width: 990px) 22vw, 45vw' }}
          {%- else -%}
            {%- assign ph = forloop.index0 | modulo: 6 | plus: 1 -%}
            {{ 'apparel-' | append: ph | placeholder_svg_tag: 'placeholder placeholder--dark' }}
          {%- endif -%}
        </div>
        {%- if block.settings.title != blank -%}
          <span class="glass-card__title">{{ block.settings.title }}</span>
        {%- endif -%}
      </a>
    {%- endfor -%}
  </div>
  {%- if section.settings.button_label != blank -%}
    <div class="float-cards__cta">
      <a href="{{ section.settings.button_link }}" class="btn btn--light"><span>{{ section.settings.button_label }}</span> {% render 'icon', icon: 'arrow' %}</a>
    </div>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "Floating 3D cards",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Small text", "default": "Capsule" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "The Signature Edit" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Explore the edit" },
    { "type": "url", "id": "button_link", "label": "Button link" }
  ],
  "blocks": [
    {
      "type": "card",
      "name": "Card",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "title", "label": "Title" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "max_blocks": 5,
  "presets": [
    {
      "name": "Floating 3D cards",
      "blocks": [
        { "type": "card", "settings": { "title": "Suits" } },
        { "type": "card", "settings": { "title": "Knitwear" } },
        { "type": "card", "settings": { "title": "Outerwear" } },
        { "type": "card", "settings": { "title": "Shirts" } },
        { "type": "card", "settings": { "title": "Shoes" } }
      ]
    }
  ]
}
{% endschema %}
