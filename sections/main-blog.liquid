<section class="section">
  <div class="container">
    <header class="collection__head"><h1 class="collection__title">{{ blog.title }}</h1></header>
    {%- paginate blog.articles by 9 -%}
      <div class="grid grid--3">
        {%- for article in blog.articles -%}
          <article class="card reveal">
            <a href="{{ article.url }}" class="card__media card__media--wide">
              {%- if article.image -%}
                {{ article.image | image_url: width: 900 | image_tag: loading: 'lazy', class: 'card__img', widths: '400, 600, 900', sizes: '(min-width: 990px) 33vw, 100vw' }}
              {%- else -%}
                {{ 'lifestyle-1' | placeholder_svg_tag: 'card__img placeholder' }}
              {%- endif -%}
            </a>
            <div class="card__info">
              <p class="card__vendor">{{ article.published_at | date: format: 'date' }}</p>
              <h3 class="card__title"><a href="{{ article.url }}">{{ article.title }}</a></h3>
            </div>
          </article>
        {%- endfor -%}
      </div>
      {% render 'pagination', paginate: paginate %}
    {%- endpaginate -%}
  </div>
</section>

{% schema %}
{ "name": "Blog", "settings": [] }
{% endschema %}
