<section class="section rich-text">
  <div class="container container--narrow rich-text__inner reveal" style="text-align: {{ section.settings.align }};">
    {%- if section.settings.eyebrow != blank -%}<p class="eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
    {%- if section.settings.heading != blank -%}<h2 class="h1">{{ section.settings.heading }}</h2>{%- endif -%}
    {%- if section.settings.text != blank -%}<div class="rte">{{ section.settings.text }}</div>{%- endif -%}
    {%- if section.settings.button_label != blank -%}
      <a href="{{ section.settings.button_link }}" class="btn btn--outline"><span>{{ section.settings.button_label }}</span></a>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Rich text",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Small text" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Quiet luxury, made to last" },
    { "type": "richtext", "id": "text", "label": "Text" },
    { "type": "text", "id": "button_label", "label": "Button label" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    {
      "type": "select", "id": "align", "label": "Alignment", "default": "center",
      "options": [{ "value": "start", "label": "Start" }, { "value": "center", "label": "Center" }]
    }
  ],
  "presets": [{ "name": "Rich text" }]
}
{% endschema %}
