{%- assign collection = section.settings.collection -%}
<section class="section featured-collection">
  <div class="container">
    <div class="section-head">
      <div>
        {%- if section.settings.eyebrow != blank -%}<p class="eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
        <h2 class="h2">{{ section.settings.heading | default: collection.title }}</h2>
      </div>
      {%- if section.settings.show_view_all and collection != blank -%}
        <a href="{{ collection.url }}" class="link-arrow">{{ 'general.view_all' | t }} {% render 'icon', icon: 'arrow' %}</a>
      {%- endif -%}
    </div>

    <div class="grid grid--{{ section.settings.columns }}{% if section.settings.slider_mobile %} grid--scroll-mobile{% endif %}">
      {%- if collection != blank and collection.products_count > 0 -%}
        {%- for product in collection.products limit: section.settings.limit -%}
          {% render 'product-card', product: product, index: forloop.index0 %}
        {%- endfor -%}
      {%- else -%}
        {%- for i in (1..section.settings.columns) -%}
          {% render 'product-card', product: blank, index: forloop.index0 %}
        {%- endfor -%}
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Featured collection",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Small text", "default": "New arrivals" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Catalog" },
    { "type": "collection", "id": "collection", "label": "Collection" },
    { "type": "range", "id": "limit", "label": "Products to show", "min": 2, "max": 24, "step": 1, "default": 8 },
    { "type": "range", "id": "columns", "label": "Columns (desktop)", "min": 2, "max": 5, "step": 1, "default": 4 },
    { "type": "checkbox", "id": "slider_mobile", "label": "Swipe on mobile", "default": true },
    { "type": "checkbox", "id": "show_view_all", "label": "Show “View all”", "default": true }
  ],
  "presets": [{ "name": "Featured collection" }]
}
{% endschema %}
