<section class="marquee marquee--{{ section.settings.style }}" style="--speed: {{ section.settings.speed }}s;">
  <div class="marquee__track">
    {%- for i in (1..4) -%}
      <span class="marquee__item">
        {%- for block in section.blocks -%}
          <span {{ block.shopify_attributes }}>{{ block.settings.text }}</span><span class="marquee__sep">✦</span>
        {%- endfor -%}
      </span>
    {%- endfor -%}
  </div>
</section>

{% schema %}
{
  "name": "Scrolling text",
  "settings": [
    {
      "type": "select", "id": "style", "label": "Style", "default": "dark",
      "options": [
        { "value": "dark", "label": "Dark" },
        { "value": "light", "label": "Light" },
        { "value": "outline", "label": "Outline (large)" }
      ]
    },
    { "type": "range", "id": "speed", "label": "Speed (seconds per loop)", "min": 10, "max": 80, "step": 5, "default": 35 }
  ],
  "blocks": [
    { "type": "text", "name": "Text", "settings": [{ "type": "text", "id": "text", "label": "Text", "default": "Made in Italy" }] }
  ],
  "presets": [
    {
      "name": "Scrolling text",
      "blocks": [
        { "type": "text", "settings": { "text": "Made in Italy" } },
        { "type": "text", "settings": { "text": "Crafted in Istanbul" } },
        { "type": "text", "settings": { "text": "Premium fabrics" } },
        { "type": "text", "settings": { "text": "Tailored fit" } }
      ]
    }
  ]
}
{% endschema %}
