<section class="password">
  <div class="password__inner">
    <p class="eyebrow">{{ 'password.coming_soon' | t }}</p>
    <h1 class="display">{{ shop.name }}</h1>
    {%- if shop.password_message != blank -%}<p>{{ shop.password_message }}</p>{%- endif -%}
    {%- form 'customer', class: 'newsletter__form' -%}
      <input type="hidden" name="contact[tags]" value="prospect,password page">
      {%- if form.posted_successfully? -%}
        <p class="form-message form-message--success">{{ 'newsletter.success' | t }}</p>
      {%- else -%}
        <div class="field-inline">
          <input type="email" name="contact[email]" required placeholder="{{ 'newsletter.placeholder' | t }}" aria-label="{{ 'newsletter.placeholder' | t }}">
          <button type="submit" class="btn btn--light">{{ 'newsletter.button' | t }}</button>
        </div>
      {%- endif -%}
    {%- endform -%}
    <details class="password__login">
      <summary>{{ 'password.enter' | t }}</summary>
      {%- form 'storefront_password', class: 'field-inline' -%}
        {{ form.errors | default_errors }}
        <input type="password" name="password" placeholder="{{ 'customer.password' | t }}" aria-label="{{ 'customer.password' | t }}">
        <button type="submit" class="btn btn--light">{{ 'password.enter' | t }}</button>
      {%- endform -%}
    </details>
  </div>
</section>

{% schema %}
{ "name": "Password page", "settings": [] }
{% endschema %}
