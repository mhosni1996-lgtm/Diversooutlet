{%- comment -%}
  Scattered image collage that assembles itself as you scroll in.
{%- endcomment -%}
<section class="collage section" data-collage>
  <div class="container">
    {%- if section.settings.heading != blank -%}
      <div class="section-head">
        <h2 class="h2">{{ section.settings.heading }}</h2>
        {%- if section.settings.link_label != blank -%}
          <a href="{{ section.settings.link }}" class="link-arrow">{{ section.settings.link_label }} {% render 'icon', icon: 'arrow' %}</a>
        {%- endif -%}
      </div>
    {%- endif -%}
    <div class="collage__grid">
      {%- for block in section.blocks -%}
        {%- assign n = forloop.index0 | modulo: 6 -%}
        <a
          href="{{ block.settings.link | default: '#' }}"
          class="collage__item collage__item--{{ n }}"
          style="--d: {{ forloop.index0 | times: 70 }}ms;"
          {{ block.shopify_attributes }}
        >
          {%- if block.settings.image != blank -%}
            {{ block.settings.image | image_url: width: 1000 | image_tag: loading: 'lazy', widths: '400, 700, 1000', sizes: '(min-width: 990px) 33vw, 50vw' }}
          {%- else -%}
            {%- assign ph = forloop.index0 | modulo: 4 | plus: 1 -%}
            {{ 'lifestyle-' | append: ph | placeholder_svg_tag: 'placeholder' }}
          {%- endif -%}
          {%- if block.settings.caption != blank -%}
            <span class="collage__caption">{{ block.settings.caption }}</span>
          {%- endif -%}
        </a>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Collage",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "The Lookbook" },
    { "type": "text", "id": "link_label", "label": "Link label", "default": "Discover" },
    { "type": "url", "id": "link", "label": "Link" }
  ],
  "blocks": [
    {
      "type": "image",
      "name": "Image",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "caption", "label": "Caption" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "max_blocks": 12,
  "presets": [
    {
      "name": "Collage",
      "blocks": [
        { "type": "image" }, { "type": "image" }, { "type": "image" },
        { "type": "image" }, { "type": "image" }, { "type": "image" }
      ]
    }
  ]
}
{% endschema %}
