<section class="section split{% if section.settings.reverse %} split--reverse{% endif %} split--{{ section.settings.theme }}">
  <div class="split__media" data-parallax-img>
    {%- if section.settings.image != blank -%}
      {{ section.settings.image | image_url: width: 1600 | image_tag: loading: 'lazy', widths: '600, 900, 1200, 1600', sizes: '(min-width: 990px) 50vw, 100vw' }}
    {%- else -%}
      {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder' }}
    {%- endif -%}
  </div>
  <div class="split__content reveal">
    {%- if section.settings.eyebrow != blank -%}<p class="eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
    {%- if section.settings.heading != blank -%}<h2 class="h1">{{ section.settings.heading }}</h2>{%- endif -%}
    {%- if section.settings.text != blank -%}<div class="rte">{{ section.settings.text }}</div>{%- endif -%}
    {%- if section.settings.button_label != blank -%}
      <a href="{{ section.settings.button_link }}" class="btn{% if section.settings.theme == 'dark' %} btn--light{% endif %}">
        <span>{{ section.settings.button_label }}</span> {% render 'icon', icon: 'arrow' %}
      </a>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Image with text",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "text", "id": "eyebrow", "label": "Small text", "default": "Our story" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Between Istanbul and Milan" },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Every piece is selected from the finest Turkish ateliers and Italian mills — refined cuts, premium fabrics and timeless details for the modern gentleman.</p>" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Discover" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    { "type": "checkbox", "id": "reverse", "label": "Image on the other side", "default": false },
    {
      "type": "select", "id": "theme", "label": "Color", "default": "light",
      "options": [
        { "value": "light", "label": "Light" },
        { "value": "alt", "label": "Beige" },
        { "value": "dark", "label": "Dark" }
      ]
    }
  ],
  "presets": [{ "name": "Image with text" }]
}
{% endschema %}
