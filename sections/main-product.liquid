{%- liquid
  assign current_variant = product.selected_or_first_available_variant
  assign media_count = product.media.size
-%}
<section class="product" data-product data-section="{{ section.id }}">
  <div class="product__gallery product__gallery--{{ section.settings.gallery_layout }}" data-gallery>
    {%- if media_count > 0 -%}
      {%- for media in product.media -%}
        <div class="product__media{% if forloop.first %} is-first{% endif %}" data-media-id="{{ media.id }}">
          {%- case media.media_type -%}
            {%- when 'image' -%}
              {{
                media
                | image_url: width: 1600
                | image_tag:
                  loading: 'lazy',
                  widths: '600, 900, 1200, 1600',
                  sizes: '(min-width: 990px) 33vw, 90vw',
                  class: 'product__img'
              }}
            {%- when 'video' -%}
              {{ media | video_tag: autoplay: true, loop: true, muted: true, playsinline: true, controls: false, class: 'product__img' }}
            {%- when 'external_video' -%}
              {{ media | external_video_tag: class: 'product__img' }}
            {%- else -%}
              {{ media | media_tag: class: 'product__img' }}
          {%- endcase -%}
        </div>
      {%- endfor -%}
    {%- else -%}
      <div class="product__media is-first">{{ 'product-1' | placeholder_svg_tag: 'product__img placeholder' }}</div>
    {%- endif -%}
  </div>

  <div class="product__info">
    <div class="product__info-inner">
      {%- form 'product', product, class: 'product-form', data-product-form: '', novalidate: 'novalidate' -%}
        <input type="hidden" name="id" value="{{ current_variant.id }}" data-variant-id>

        {%- for block in section.blocks -%}
          {%- case block.type -%}
            {%- when '@app' -%}
              {% render block %}

            {%- when 'vendor' -%}
              <p class="product__vendor" {{ block.shopify_attributes }}>{{ product.vendor }}</p>

            {%- when 'title' -%}
              <h1 class="product__title" {{ block.shopify_attributes }}>{{ product.title }}</h1>

            {%- when 'price' -%}
              <div class="product__price" {{ block.shopify_attributes }} data-price-wrap>
                {% render 'price', product: product, variant: current_variant %}
                {%- if cart.taxes_included or shop.shipping_policy.body != blank -%}
                  <p class="product__tax">{{ 'products.product.tax_note' | t }}</p>
                {%- endif -%}
              </div>

            {%- when 'variant_picker' -%}
              {%- unless product.has_only_default_variant -%}
                <div class="variant-picker" {{ block.shopify_attributes }}>
                  {%- for option in product.options_with_values -%}
                    {%- assign option_index = forloop.index0 -%}
                    <fieldset class="variant-picker__option" data-option-index="{{ forloop.index0 }}">
                      <legend>
                        {{ option.name }}: <span data-option-value>{{ option.selected_value }}</span>
                      </legend>
                      <div class="variant-picker__values">
                        {%- for value in option.values -%}
                          <label class="pill{% unless value.available %} is-unavailable{% endunless %}">
                            <input
                              type="radio"
                              name="option-{{ option_index }}"
                              value="{{ value | escape }}"
                              {% if value.selected %}checked{% endif %}
                            >
                            <span>{{ value }}</span>
                          </label>
                        {%- endfor -%}
                      </div>
                    </fieldset>
                  {%- endfor -%}
                  {%- if block.settings.size_guide != blank -%}
                    <button type="button" class="link-underline" data-modal-open="size-guide">{{ 'products.product.size_guide' | t }}</button>
                    <div class="modal" data-modal="size-guide" aria-hidden="true">
                      <div class="modal__box">
                        <button type="button" class="icon-btn modal__close" data-modal-close aria-label="{{ 'general.close' | t }}">{% render 'icon', icon: 'close' %}</button>
                        <h2 class="h3">{{ block.settings.size_guide.title }}</h2>
                        <div class="rte">{{ block.settings.size_guide.content }}</div>
                      </div>
                    </div>
                  {%- endif -%}
                </div>
              {%- endunless -%}

            {%- when 'quantity' -%}
              <div class="product__qty" {{ block.shopify_attributes }}>
                <label for="Quantity-{{ section.id }}">{{ 'products.product.quantity' | t }}</label>
                <div class="qty qty--input">
                  <button type="button" data-qty-step="-1" aria-label="{{ 'cart.decrease' | t }}">{% render 'icon', icon: 'minus' %}</button>
                  <input id="Quantity-{{ section.id }}" type="number" name="quantity" value="1" min="1" inputmode="numeric">
                  <button type="button" data-qty-step="1" aria-label="{{ 'cart.increase' | t }}">{% render 'icon', icon: 'plus' %}</button>
                </div>
              </div>

            {%- when 'buy_buttons' -%}
              <div class="product__buttons" {{ block.shopify_attributes }}>
                <button
                  type="submit"
                  name="add"
                  class="btn btn--block"
                  data-add-to-cart
                  {% unless current_variant.available %}disabled{% endunless %}
                >
                  <span data-add-label>
                    {%- if current_variant.available -%}
                      {{ 'products.product.add_to_cart' | t }}
                    {%- else -%}
                      {{ 'products.product.sold_out' | t }}
                    {%- endif -%}
                  </span>
                </button>
                {%- if block.settings.show_dynamic_checkout -%}
                  {{ form | payment_button }}
                {%- endif -%}
                {%- if block.settings.whatsapp and settings.whatsapp_number != blank -%}
                  {%- assign wa_number = settings.whatsapp_number | remove: '+' | remove: ' ' | remove: '-' -%}
                  {%- capture wa_text -%}{{ 'products.product.whatsapp_message' | t }} {{ product.title }} — {{ shop.url }}{{ product.url }}{%- endcapture -%}
                  <a href="https://wa.me/{{ wa_number }}?text={{ wa_text | url_encode }}" class="btn btn--outline btn--block btn--wa" target="_blank" rel="noopener" data-wa-link data-wa-base="{{ wa_text | escape }}">
                    {% render 'icon', icon: 'whatsapp' %} <span>{{ 'products.product.order_whatsapp' | t }}</span>
                  </a>
                {%- endif -%}
                <p class="form-message form-message--error" data-form-error hidden></p>
              </div>

            {%- when 'description' -%}
              {%- if product.description != blank -%}
                <details class="accordion" open {{ block.shopify_attributes }}>
                  <summary>{{ 'products.product.description' | t }} {% render 'icon', icon: 'plus' %}</summary>
                  <div class="accordion__body rte">{{ product.description }}</div>
                </details>
              {%- endif -%}

            {%- when 'collapsible' -%}
              <details class="accordion" {{ block.shopify_attributes }}>
                <summary>{{ block.settings.heading }} {% render 'icon', icon: 'plus' %}</summary>
                <div class="accordion__body rte">
                  {{ block.settings.content }}
                  {{ block.settings.page.content }}
                </div>
              </details>

            {%- when 'text' -%}
              <div class="product__text rte" {{ block.shopify_attributes }}>{{ block.settings.text }}</div>
          {%- endcase -%}
        {%- endfor -%}
      {%- endform -%}
    </div>
  </div>

  <script type="application/json" data-product-json>
    {{ product | json }}
  </script>
</section>

<script type="application/ld+json">
  {{ product | structured_data }}
</script>

{% schema %}
{
  "name": "Product",
  "class": "section-product",
  "settings": [
    {
      "type": "select", "id": "gallery_layout", "label": "Gallery layout (desktop)", "default": "grid",
      "options": [
        { "value": "grid", "label": "Two-column grid" },
        { "value": "stack", "label": "Single column" }
      ]
    }
  ],
  "blocks": [
    { "type": "@app" },
    { "type": "vendor", "name": "Vendor", "limit": 1 },
    { "type": "title", "name": "Title", "limit": 1 },
    { "type": "price", "name": "Price", "limit": 1 },
    {
      "type": "variant_picker", "name": "Variant picker", "limit": 1,
      "settings": [{ "type": "page", "id": "size_guide", "label": "Size guide page" }]
    },
    { "type": "quantity", "name": "Quantity", "limit": 1 },
    {
      "type": "buy_buttons", "name": "Buy buttons", "limit": 1,
      "settings": [
        { "type": "checkbox", "id": "show_dynamic_checkout", "label": "Show “Buy it now”", "default": true },
        { "type": "checkbox", "id": "whatsapp", "label": "Show “Order on WhatsApp”", "default": true }
      ]
    },
    { "type": "description", "name": "Description", "limit": 1 },
    {
      "type": "collapsible", "name": "Collapsible tab",
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "Shipping & returns" },
        { "type": "richtext", "id": "content", "label": "Content" },
        { "type": "page", "id": "page", "label": "Or content from page" }
      ]
    },
    {
      "type": "text", "name": "Text",
      "settings": [{ "type": "richtext", "id": "text", "label": "Text" }]
    }
  ]
}
{% endschema %}
